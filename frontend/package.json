{
  "name": "frontend",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.3.1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc -b && bun --bun vite build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives && node --test oxlint-plugins/*.test.js",
    "preview": "bun --bun vite preview",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:e2e": "bun --bun playwright test",
    "check:bundle": "bun scripts/check-bundle-budget.mjs",
    "gen:api": "bun --bun openapi-typescript ../backend/openapi.json -o src/types/api.gen.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
