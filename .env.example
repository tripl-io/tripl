# ── Backend ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tripl:tripl@localhost:5432/tripl
SYNC_DATABASE_URL=postgresql+psycopg://tripl:tripl@localhost:5432/tripl
# Alembic uses DATABASE_URL (asyncpg). Percent-encode reserved characters in
# URL credentials; for example, @ becomes %40.
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=

DEBUG=true
APP_BASE_URL=http://127.0.0.1:5173

# Session cookies. SECURE must be true for any HTTPS deployment.
SESSION_COOKIE_NAME=tripl_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# Fernet key for encrypting data-source and alert-destination secrets at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production; empty is tolerated only when DEBUG=true.
ENCRYPTION_KEY=

# Signing key for session cookies. Required by the production stack
# (compose.yaml). This file is the BACKEND DEVELOPMENT template; for a
# deployment, `tripl install` generates SECRET_KEY (and ENCRYPTION_KEY,
# POSTGRES_PASSWORD, RABBITMQ_PASSWORD) into a 0600 .env for you — one recipe,
# in one place, instead of the three that used to be published here, in
# deployment.md and in the backend's own error message.
# By hand: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# CORS allow-list (comma-separated). When empty:
#   - DEBUG=true  → "*" (no credentials)
#   - DEBUG=false → derived from APP_BASE_URL, or denied if both empty
CORS_ALLOW_ORIGINS=

# Security headers. HSTS should be off until you serve over HTTPS exclusively.
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
# Optional Content-Security-Policy. Leave empty to omit the header until you've
# reviewed a policy for your origin (e.g. "default-src 'self'").
CONTENT_SECURITY_POLICY=

# Rate limiting for auth endpoints. 0 disables an individual limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
# Only behind a trusted proxy that OVERWRITES the client-IP headers: with this
# on, a caller can otherwise set its own X-Forwarded-For and walk past the
# limits above.
# RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Who may create an account. `open` lets anyone who can reach the instance
# self-register as an EDITOR, which can read the whole tracking plan and the
# user roster. Owners can invite people by link regardless, so a reachable
# instance should set this to `disabled` once the team has accounts.
# REGISTRATION_MODE=open

# Organizations. `self_hosted` (the default) is one team's instance: everyone
# is in the default organization and the instance owners are platform admins.
# `hosted` is a multi-tenant service, where platform admins come only from
# PLATFORM_ADMIN_EMAILS (comma-separated). Both are read when the database is
# migrated; the rest of hosted mode arrives in later releases.
# DEPLOYMENT_MODE=self_hosted
# PLATFORM_ADMIN_EMAILS=
# Whether an organization without its own AI / SMTP / embeddings settings uses
# the operator's (`all`) or has those features off (`none`). Stored now, takes
# effect in a later release.
# ORG_SETTINGS_OPERATOR_FALLBACK=all
# Refuse outbound requests (warehouses, identity providers, webhooks) to
# private or internal addresses. Always on with
# DEPLOYMENT_MODE=hosted; set it on a self-hosted instance whose users must not
# reach its own network.
# OUTBOUND_PUBLIC_HOSTS_ONLY=false

# Sign in with Google: an OAuth client (Web application) from the Google Cloud
# console, with https://<your host>/api/v1/auth/google/callback as its
# authorized redirect URI. Both set turns the button on. GOOGLE_ALLOWED_DOMAINS
# (comma-separated) limits who may sign up with it; empty allows any.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS=

# Sign in through your own OpenID Connect provider (Okta, Microsoft Entra ID,
# Keycloak, ...), beside or instead of Google: register a web client with
# https://<your host>/api/v1/auth/oidc/callback as its redirect URI. Issuer,
# client id and secret all set turn the button on. An address the provider
# verified signs in to the account that has it, so set OIDC_ALLOWED_DOMAINS
# (it applies to every account, platform admins included).
# See website/docs/administer/admin-guide.md#instance-sign-in.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_BUTTON_LABEL=Sign in with Okta
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_AUTO_CREATE_USERS=true
# Enterprise: a public demo instance (website/docs/run/public-demo.md): PUBLIC_DEMO=true
# refuses whatever would reach outside the instance, and with
# DEPLOYMENT_MODE=hosted IDLE_ORG_RETENTION_DAYS (Enterprise) deletes organizations nobody
# has used for that many days (0, the default, deletes none).
# PUBLIC_DEMO=false

# Enterprise: the license key (tripl1.…). Set, it wins over a key saved in
# Settings → Platform → License. Without a valid one Enterprise keeps running
# and warns. Community ignores it.
# LICENSE_KEY=
# IDLE_ORG_RETENTION_DAYS=0

# Logging. LOG_JSON=true emits one-line JSON suited for container log shippers.
LOG_LEVEL=INFO
LOG_JSON=false
REQUEST_ID_HEADER=X-Request-ID

# Daily maintenance of operational history. Scan-job age is measured from
# completion, and active scan jobs are retained;
# significant distribution drift is kept longer than stable/minor drift.
SCAN_JOB_RETENTION_DAYS=90
DISTRIBUTION_DRIFT_RETENTION_DAYS=90
DISTRIBUTION_DRIFT_MINOR_RETENTION_DAYS=30

# Daily sweep of uploaded photo files that no photo row references any more
# (left behind by deleting an event, project or branch). Files younger than
# this many hours are never touched.
PHOTO_ORPHAN_SWEEP_GRACE_HOURS=24

# Prometheus /metrics endpoint + Celery task instrumentation. Off by default
# so dev runs stay quiet; production/staging should turn it on and expose
# /metrics only on an internal-only ingress path (or scrape via sidecar).
PROMETHEUS_METRICS_ENABLED=false
# For a manual multi-process deployment, all API and Celery worker processes
# must share this writable directory. Compose sets and mounts it for you.
# PROMETHEUS_MULTIPROC_DIR=/app/var/prometheus

# OpenTelemetry traces. Leave the endpoint empty to disable tracing entirely.
# The production image includes the OpenTelemetry dependencies.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=tripl

# Outbound email: alert destinations, scheduled digests, and password-reset
# links. A blank SMTP_HOST disables all of them; everything else here is ignored
# until it is set. SMTP_FROM_ADDRESS is required too — without it a reset link
# is minted and then never sent.
#
# SMTP_SECURITY picks the transport, and it has to match the port:
#   starttls      connect in the clear, then upgrade. Ports 587 and 2525.
#   implicit_tls  TLS from the first byte (SMTPS). Port 465.
#   none          plaintext throughout. Only for a relay you trust the path to.
# Pointing starttls at an implicit-TLS port does not fail fast — the client waits
# for a greeting that never comes and stalls until its timeout.
#
# SMTP_USE_TLS is DEPRECATED and only supplies SMTP_SECURITY's default when that
# is unset (true -> starttls, false -> none). Set SMTP_SECURITY instead; it wins.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=

# Demo workspace kill switches. DEMO_ENABLED gates demo provisioning — both
# create AND reset, since a reset re-seeds a demo from scratch and is therefore a
# provisioning path too. DEMO_RUNTIME_ENABLED gates the background tick that
# keeps an existing demo's data fresh. Deleting a demo stays available in every
# state of these flags, so a workspace can never be stuck with a demo it cannot
# remove. Neither flag affects real projects.
DEMO_ENABLED=true
DEMO_RUNTIME_ENABLED=true

# Enterprise: demos kept seeded ahead of time, so a visitor gets one at once (0 = off; a
# public demo might keep 5). Entries older than DEMO_POOL_MAX_AGE_HOURS are
# seeded again.
DEMO_POOL_SIZE=0
DEMO_POOL_MAX_AGE_HOURS=20

# Hybrid knowledge search embeddings. Lexical/fuzzy search works without these.
# Enabling embeddings sends non-sensitive indexed tracking-plan text to the
# configured provider.
SEARCH_EMBEDDINGS_ENABLED=false
SEARCH_EMBEDDING_PROVIDER=openai
SEARCH_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_EMBEDDING_DIMENSIONS=1536
SEARCH_EMBEDDING_API_KEY=
# Base URL of an OpenAI-compatible embeddings endpoint; "/embeddings" is
# appended. Point this at a self-hosted provider to keep tracking-plan text
# inside your own infrastructure. Changing it after documents are indexed
# requires a re-index — vectors from two providers are not comparable.
SEARCH_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# AI assist (plan search answers, suggestions). Enabling it sends plan text to
# the configured provider. AI_API_KEY falls back to OPENAI_API_KEY when blank.
# AI_ENABLED=false
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# Event photo uploads.
#   PHOTO_STORAGE_BACKEND=local writes to PHOTO_LOCAL_DIR and serves bytes
#     through an authenticated API endpoint.
#   PHOTO_STORAGE_BACKEND=gcs uploads to GCS_PHOTO_BUCKET and returns signed
#     URLs (or public URLs if GCS_PHOTO_PUBLIC=true).
PHOTO_STORAGE_BACKEND=local
PHOTO_LOCAL_DIR=./var/photos
PHOTO_MAX_SIZE_MB=10
MAX_REQUEST_BODY_MB=2
PHOTO_ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp
GCS_PHOTO_BUCKET=
# Path to a service-account JSON. Empty falls back to Application Default
# Credentials (GOOGLE_APPLICATION_CREDENTIALS or workload identity).
GCS_PHOTO_CREDENTIALS_PATH=
GCS_PHOTO_PUBLIC=false
GCS_PHOTO_SIGNED_URL_TTL_SECONDS=3600

# ── PostgreSQL (Docker Compose) ────────────────────────────────────────────
POSTGRES_USER=tripl
POSTGRES_DB=tripl
# Production stack (compose.yaml) builds DATABASE_URL from this and REQUIRES a
# non-default value (must not be "tripl"). Generate one — see website/docs/run/deployment.md.
# The dev stack (compose.dev.yaml) uses its own built-in dev password instead.
POSTGRES_PASSWORD=

# ── RabbitMQ (Docker Compose, production) ──────────────────────────────────
# Production stack REQUIRES this; the broker user is "tripl". Generate a value.
RABBITMQ_PASSWORD=

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000

# ── Release image (compose.yaml / production) ───────────────────────────────
# The default compose.yaml runs the PUBLISHED image instead of building locally.
# Pin TRIPL_VERSION to a released tag in production; `latest` is fine for trials.
# Publish a new image with bin/release.sh — see website/docs/run/release.md.
TRIPL_IMAGE=ghcr.io/tripl-io/tripl
TRIPL_VERSION=latest
